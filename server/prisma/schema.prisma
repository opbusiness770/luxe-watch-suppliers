generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPPLIER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  WAREHOUSE_RECEIPT
  ALLOCATION
  SALE
  SALE_REVERSAL
  ADJUSTMENT
}

enum BusinessAuditEventType {
  WATCH_DELETED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  supplier Supplier?

  createdStockAllocations      StockAllocation[]      @relation("StockAllocationCreatedBy")
  createdInventoryTransactions InventoryTransaction[] @relation("InventoryTransactionCreatedBy")

  deletedWatches Watch[] @relation("WatchDeletedBy")

  businessAuditLogs BusinessAuditLog[] @relation("BusinessAuditLogCreatedBy")

  @@index([role, isActive])
}

model Supplier {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  contactName String  @db.VarChar(150)
  phone       String? @db.VarChar(30)
  address     String?
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  inventories           SupplierInventory[]
  allocations           StockAllocation[]
  sales                 Sale[]
  inventoryTransactions InventoryTransaction[]

  @@index([contactName])
}

model Watch {
  id String @id @default(uuid()) @db.Uuid

  brand String @db.VarChar(100)
  model String @db.VarChar(150)
  name  String @db.VarChar(200)

  description String?

  imageUrl String? @db.VarChar(2048)

  imageUrls      String[] @default([])
  imagePublicIds String[] @default([])

  adminCostPrice       Decimal @db.Decimal(12, 2)
  defaultSupplierPrice Decimal @db.Decimal(12, 2)
  recommendedSalePrice Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  deletedAt       DateTime? @db.Timestamptz(3)
  deletedByUserId String?   @db.Uuid
  deletionReason  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  deletedByUser User? @relation("WatchDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  warehouseInventory    WarehouseInventory?
  supplierInventories   SupplierInventory[]
  allocations           StockAllocation[]
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]

  businessAuditLogs BusinessAuditLog[]

  @@index([brand])
  @@index([isActive])
  @@index([deletedAt])
}

model WarehouseInventory {
  watchId String @id @db.Uuid

  quantityOnHand Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Restrict)
}

model SupplierInventory {
  supplierId String @db.Uuid
  watchId    String @db.Uuid

  quantityOnHand Int @default(0)

  supplierCostPrice Decimal @db.Decimal(12, 2)
  requiredSalePrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  watch    Watch    @relation(fields: [watchId], references: [id], onDelete: Restrict)

  @@id([supplierId, watchId])
  @@index([watchId])
}

model StockAllocation {
  id String @id @default(uuid()) @db.Uuid

  supplierId      String @db.Uuid
  watchId         String @db.Uuid
  createdByUserId String @db.Uuid

  quantity Int

  supplierCostPrice Decimal @db.Decimal(12, 2)
  requiredSalePrice Decimal @db.Decimal(12, 2)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  watch         Watch    @relation(fields: [watchId], references: [id], onDelete: Restrict)
  createdByUser User     @relation("StockAllocationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
  @@index([watchId, createdAt])
}

model Sale {
  id String @id @default(uuid()) @db.Uuid

  supplierId String @db.Uuid

  status SaleStatus @default(COMPLETED)

  totalAmount Decimal @db.Decimal(12, 2)

  soldAt DateTime @default(now()) @db.Timestamptz(3)
  notes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items SaleItem[]

  @@index([supplierId, soldAt])
  @@index([status, soldAt])
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid

  saleId  String @db.Uuid
  watchId String @db.Uuid

  quantity Int

  salePrice         Decimal @db.Decimal(12, 2)
  supplierCostPrice Decimal @db.Decimal(12, 2)

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([watchId])
}

model InventoryTransaction {
  id String @id @default(uuid()) @db.Uuid

  supplierId      String? @db.Uuid
  watchId         String  @db.Uuid
  createdByUserId String? @db.Uuid

  type InventoryTransactionType

  quantityChange Int
  balanceAfter   Int

  referenceId String? @db.Uuid
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  watch         Watch     @relation(fields: [watchId], references: [id], onDelete: Restrict)
  createdByUser User?     @relation("InventoryTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
  @@index([watchId, createdAt])
  @@index([type, createdAt])
}

model BusinessAuditLog {
  id String @id @default(uuid()) @db.Uuid

  eventType BusinessAuditEventType

  watchId         String? @db.Uuid
  createdByUserId String  @db.Uuid

  note String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  watch         Watch? @relation(fields: [watchId], references: [id], onDelete: Restrict)
  createdByUser User   @relation("BusinessAuditLogCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([eventType, createdAt])
  @@index([watchId, createdAt])
  @@index([createdByUserId, createdAt])
}
